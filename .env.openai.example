# ================= GPT（openai 容器）配置模板 =================
# 复制为 .env.openai 并填写实际值，配合 docker-compose.openai.yml 使用
# AI_BACKEND=openai / BOT_ID=openai / FLASK_PORT=35001 已在 compose 中设置
#
# openai 后端使用官方 openai SDK（LiteLLM 已移除）：
# - 模型名含 "gemini" → Chat Completions
# - 其他模型 → Responses API（GPT 使用 store=True + previous_response_id 续接）

# === 钉钉（使用独立于其他容器的钉钉应用） ===
DINGTALK_CLIENT_ID=your_dingtalk_client_id
DINGTALK_CLIENT_SECRET=your_dingtalk_client_secret
PLATFORM=dingtalk

# === OpenAI 兼容端点 ===
# 自建中转站（如 cli-proxy-api）；使用 OpenAI 官方 API 时两项都可以不设
OPENAI_API_BASE=http://127.0.0.1:38317/v1
OPENAI_API_KEY=your_relay_or_openai_api_key

# === 模型（示例值；中转站下裸写模型名，不带 openai/ 前缀）===
# 改动前先 curl {OPENAI_API_BASE}/models 核对，改完端到端验证
MODEL_ROUTER=gpt-5.6-luna
MODEL_LITE=gpt-5.6-luna
MODEL_FAST=gpt-5.6-terra
MODEL_PRO=gpt-5.6-sol

# === capability 声明 ===
# *_SUPPORTS_SEARCH=true 会下发 Responses 的 web_search 工具，
# 只在上游真正支持时打开，否则可能报不支持的工具参数
OPENAI_LITE_SUPPORTS_REASONING=false
OPENAI_LITE_SUPPORTS_SEARCH=false
OPENAI_LITE_SUPPORTS_VISION=true
OPENAI_FLASH_SUPPORTS_REASONING=true
OPENAI_FLASH_SUPPORTS_SEARCH=true
OPENAI_FLASH_SUPPORTS_VISION=true
OPENAI_PRO_SUPPORTS_REASONING=true
OPENAI_PRO_SUPPORTS_SEARCH=true
OPENAI_PRO_SUPPORTS_VISION=true

# 全自主搜索：fast/pro 档始终挂原生搜索工具（模型自决是否搜索，不搜不计费），lite 档豁免
# false 回到路由 need_search 关键词门控
SEARCH_AUTONOMOUS=true
# 旧的 Gemini 搜索摘要注入兼容路径，默认关闭
SEARCH_FALLBACK_PROVIDER=none

# === 生图 ===
# gpt-image-2 走 OPENAI_API_BASE 的 images 端点；改成 imagen/gemini 模型名会自动切到 Google 直连
OPENAI_IMAGE_MODEL=gpt-image-2
# GEMINI_API_KEY=your_google_gemini_api_key

# === 网络 ===
SOCKS_PROXY=socks5h://127.0.0.1:1080

# === 腾讯云 COS（生图存储，可选） ===
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=bucket-appid
# COS_REGION=ap-guangzhou

# === 数据层（可选，不配置时降级到文件存储） ===
REDIS_HOST=127.0.0.1
REDIS_PORT=36379
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=33306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=dingtalk_gemini

# === Soul 管理员（逗号分隔用户 ID，留空表示所有人） ===
# SOUL_ADMIN_IDS=

# /v1/chat/completions 鉴权 token（必配，fail-closed：未配置时该端点拒绝服务）
# 生成方式: openssl rand -hex 32；调用方以 OpenAI 客户端 api_key 形式携带
CHAT_COMPLETIONS_BEARER_TOKEN=
