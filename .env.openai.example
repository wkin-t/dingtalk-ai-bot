# === 后端选择 ===
AI_BACKEND=openai
PLATFORM=dingtalk

# === 目标 Provider API Key ===
# DeepSeek（OpenAI 兼容模型；通常不支持 OpenAI 原生 Web Search）
DEEPSEEK_API_KEY=sk-xxx
# Qwen (取消注释使用)
# DASHSCOPE_API_KEY=sk-xxx
# GLM (取消注释使用)
# GLM_API_KEY=xxx.xxx

# === 模型配置（三档统一变量，LiteLLM provider/model 格式）===
MODEL_FAST=deepseek/deepseek-chat       # fast / lite 档
MODEL_PRO=deepseek/deepseek-reasoner    # pro 档
# MODEL_LITE=deepseek/deepseek-chat     # 留空时自动同 MODEL_FAST

# === Provider 能力声明 ===
# 只有使用 OpenAI 原生且支持 Web Search 的模型时，才把 *_SUPPORTS_SEARCH 改为 true。
# DeepSeek / Qwen / GLM / 自建 OpenAI 兼容网关不要打开，否则会下发 OpenAI web_search
# 工具参数并导致上游报不支持。
# Flash 模型能力
OPENAI_FLASH_SUPPORTS_REASONING=true
OPENAI_FLASH_SUPPORTS_SEARCH=false
OPENAI_FLASH_SUPPORTS_VISION=true
# Pro 模型能力
OPENAI_PRO_SUPPORTS_REASONING=true
OPENAI_PRO_SUPPORTS_SEARCH=false
OPENAI_PRO_SUPPORTS_VISION=true

# === 自定义 Endpoint (可选，覆盖 LiteLLM 默认) ===
# OPENAI_API_BASE=https://api.my-gateway.com/v1
# OPENAI_API_KEY=sk-xxx

# === OpenAI 原生搜索配置示例 ===
# 若要让 openai 容器也走 OpenAI Responses 原生 Web Search：
# 1. 使用 OpenAI 官方 API Key，不设置 OPENAI_API_BASE。
# 2. 将 MODEL_FAST / MODEL_PRO 设置为你确认支持 web_search 的 OpenAI 模型。
# 3. 打开对应 capability。
#
# MODEL_FAST=gpt-5-mini
# MODEL_PRO=gpt-5
# OPENAI_FLASH_SUPPORTS_SEARCH=true
# OPENAI_PRO_SUPPORTS_SEARCH=true

# === 网络控制 ===
SOCKS_PROXY=socks5h://172.16.0.8:1080
LITELLM_CONNECT_TIMEOUT=30
LITELLM_READ_TIMEOUT=120
LITELLM_MAX_RETRIES=2

# === 预分析 (仍需 Gemini API Key) ===
GEMINI_API_KEY=xxx

# === 钉钉 ===
DINGTALK_CLIENT_ID=xxx
DINGTALK_CLIENT_SECRET=xxx

# === 企微 (如需双平台，改 PLATFORM=both 并取消注释) ===
# PLATFORM=both
# WECOM_BOT_TOKEN=xxx
# WECOM_BOT_ENCODING_AES_KEY=xxx
# WECOM_BOT_CORP_ID=xxx
# WECOM_RECEIVE_ID=xxx

# === 数据层 ===
REDIS_HOST=127.0.0.1
REDIS_PORT=36379

# === Vertex AI Claude (可选，启用后覆盖上方 DeepSeek 模型) ===
# 取消注释以下行并填入实际值即可切换到 Vertex AI Claude
#
# VERTEX_PROJECT=your-gcp-project-id
# VERTEX_SA_HOST_PATH=./secrets/vertex-sa.json
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-key.json
#
# OPENAI_MODEL_FLASH=vertex_ai/claude-sonnet-4@20250514
# OPENAI_MODEL_PRO=vertex_ai/claude-opus-4-1@20250514
#
# VERTEX_REGION_FAST=europe-west1
# VERTEX_REGION_PRO=us-east5
#
# VERTEX_REASONING_PARAM_FAST=anthropic_thinking
# VERTEX_REASONING_PARAM_PRO=anthropic_thinking

# 全自主搜索：fast/pro 档始终挂原生搜索工具（模型自决是否搜索，不搜不计费），lite 档豁免
# false 回到路由 need_search 关键词门控
SEARCH_AUTONOMOUS=true
