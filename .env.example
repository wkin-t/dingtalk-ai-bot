# ================= Gemini（gemini 容器）配置模板 =================
# 复制此文件为 .env 并填写实际值，配合 docker-compose.yml 使用
# AI_BACKEND=gemini / BOT_ID=gemini / FLASK_PORT=35000 已在 compose 中设置

# 1. Google Gemini API Key（直连 Google）
# 即使对话走中转站也保留：生图 generate_images(:predict) 端点中转站不覆盖，始终直连
GEMINI_API_KEY=your_gemini_api_key

# 1.1 Gemini 中转站（可选）
# 填中转站根地址，SDK 自动拼接 /v1beta，不要带任何路径后缀；留空则直连 Google
# GEMINI_API_BASE=https://<中转站域名>/antigravity
# GEMINI_API_BASE_KEY=your_relay_api_key

# 1.2 主路径熔断后的保底路径（可选，需要显式独立 key，见 docs/deploy/gemini-circuit-breaker-rollout.md）
# GEMINI_API_BASE_FALLBACK=
# GEMINI_API_BASE_FALLBACK_KEY=

# 2. 模型配置（三档统一变量，示例值；中转站下改动前先核对模型列表）
MODEL_PRO=gemini-3.8-flash-high        # pro 档（复杂推理）
MODEL_FAST=gemini-3.8-flash-high       # fast 档（日常问答）
MODEL_ROUTER=gemini-3.8-flash-high     # 路由分析 / soul 进化 / 搜索
MODEL_LITE=gemini-3.8-flash-high       # lite 档（简单问候）
# 生图模型名含 imagen/gemini 时自动走 Google 直连
# OPENAI_IMAGE_MODEL=imagen-4.0-ultra-generate-001
# 生图 / 改图模型
# GEMINI_IMAGE_MODEL=imagen-4.0-generate-001
GEMINI_IMAGE_EDIT_MODEL=gemini-2.0-flash-exp

# 是否启用 thinking 模式 (显示模型的思考过程)
ENABLE_THINKING=true

# 是否启用 Google Search
ENABLE_SEARCH=true

# 全自主搜索：fast/pro 档始终挂原生搜索工具（模型自决是否搜索，不搜不计费），lite 档豁免
# false 回到路由 need_search 关键词门控
SEARCH_AUTONOMOUS=true

# 3. 钉钉机器人配置 (Stream 模式)
# 请在钉钉开发者后台 -> 应用详情 -> 凭证与基础信息 中获取
DINGTALK_CLIENT_ID=your_dingtalk_client_id
DINGTALK_CLIENT_SECRET=your_dingtalk_client_secret

# 平台选择: dingtalk（wecom / both 已 Deprecated）
PLATFORM=dingtalk

# 4. 代理设置
# 国内服务器直连 Google 时需要；钉钉不走代理
SOCKS_PROXY=socks5h://127.0.0.1:1080

# HTTP 代理 (用于不支持 SOCKS5 的 SDK)
HTTP_PROXY_URL=http://127.0.0.1:1087

# 5. AI 卡片模板 ID (可选，使用默认值)
# CARD_TEMPLATE_ID=ea2d035e-20fe-447d-9fbf-c04658772b24.schema

# 6. 上下文配置 (可选)
# MAX_HISTORY_LENGTH=50
# MAX_STORAGE_LENGTH=1000

# 7. 腾讯云 COS（生图存储，可选）
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=bucket-appid
# COS_REGION=ap-guangzhou

# 8. Soul 管理员（逗号分隔用户 ID，留空表示所有人）
# SOUL_ADMIN_IDS=

# ================= 数据库配置 (可选) =================
# 如果不配置，将降级到文件存储

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=36379
REDIS_PASSWORD=
REDIS_DB=0

# MySQL 配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=33306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=dingtalk_gemini

# /v1/chat/completions 鉴权 token（必配，fail-closed：未配置时该端点拒绝服务）
# 生成方式: openssl rand -hex 32；调用方以 OpenAI 客户端 api_key 形式携带
CHAT_COMPLETIONS_BEARER_TOKEN=
