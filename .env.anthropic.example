# ================= Claude（anthropic 容器）配置模板 =================
# 复制为 .env.anthropic 并填写实际值，配合 docker-compose.anthropic.yml 使用
# 2026-08-25 前该容器叫 openrouter，对应 .env.openrouter
#
# 协议后端是 AI_BACKEND=openai（compose 已设置），通过 OpenAI 兼容中转站
# 调用 Responses API，并不经过 OpenRouter。
# 如需原生 OpenRouter 后端，请参考 .env.openrouter.example。

# === 钉钉（使用独立于其他容器的钉钉应用） ===
DINGTALK_CLIENT_ID=your_dingtalk_client_id
DINGTALK_CLIENT_SECRET=your_dingtalk_client_secret
PLATFORM=dingtalk

# === OpenAI 兼容中转站 ===
OPENAI_API_BASE=https://<中转站域名>/v1
OPENAI_API_KEY=your_relay_api_key

# === 模型（示例值；裸写模型名，不带 provider 前缀）===
# 中转站模型别名会变化，改动前先 curl {OPENAI_API_BASE}/models 核对，改完端到端验证
MODEL_ROUTER=claude-sonnet-4-6
MODEL_LITE=claude-sonnet-4-6
MODEL_FAST=claude-opus-4-6-thinking
MODEL_PRO=claude-opus-4-6-thinking

# === capability 声明 ===
OPENAI_FLASH_SUPPORTS_REASONING=true
OPENAI_FLASH_SUPPORTS_VISION=true
OPENAI_PRO_SUPPORTS_REASONING=true
OPENAI_PRO_SUPPORTS_VISION=true
# 经中转站调用的 Claude 目前不执行 web_search 工具；声明为 true 不报错，但不会真正搜索
OPENAI_FLASH_SUPPORTS_SEARCH=true
OPENAI_PRO_SUPPORTS_SEARCH=true
SEARCH_AUTONOMOUS=true
SEARCH_FALLBACK_PROVIDER=none

# === 生图（可选）：Gemini/Imagen 始终直连 Google，需要直连 key 与代理 ===
# GEMINI_API_KEY=your_google_gemini_api_key
# OPENAI_IMAGE_MODEL=imagen-4.0-generate-001
SOCKS_PROXY=socks5h://127.0.0.1:1080

# === 腾讯云 COS（生图存储，可选） ===
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=bucket-appid
# COS_REGION=ap-guangzhou

# === 数据层（可选，不配置时降级到文件存储） ===
REDIS_HOST=127.0.0.1
REDIS_PORT=36379
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=33306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=dingtalk_gemini

# === Soul 管理员（逗号分隔用户 ID，留空表示所有人） ===
# SOUL_ADMIN_IDS=

# /v1/chat/completions 鉴权 token（必配，fail-closed：未配置时该端点拒绝服务）
# 生成方式: openssl rand -hex 32；调用方以 OpenAI 客户端 api_key 形式携带
CHAT_COMPLETIONS_BEARER_TOKEN=
