# 环境变量文件 (包含敏感信息)
.env
.env.*
!.env.example
!.env.*.example

# Claude Code / Continue 配置（.claude 含 SSH 别名、服务器路径等部署信息，整体不入库）
.claude/
.continue/

# Demo 目录 (参考代码)
demo/
demo/wxwork/aibot_demo_python/

# 临时目录（本地调试/克隆上游仓库）
.tmp/

# 1Panel 模板 (实际使用的在服务器 1Panel 管理)
1panel/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# 数据目录（各容器独立：data-openai/、data-anthropic/ 等，含 Soul 与对话历史）
data/
data-*/

# Tailscale 数据
tailscale_data/

# IDE
.idea/
.vscode/
*.swp
*.swo

# 日志
*.log

# 系统文件
.DS_Store
Thumbs.db
NUL

# 测试覆盖率
.coverage
.hypothesis/
htmlcov/
.pytest_cache/

# GitHub Actions（如果是本地测试生成的）
.github/

# 凭证文件（Service Account、API Key 等）
secrets/
credentials/
*.sa.json
*.key.json
*service-account*.json

# 内部修复文档（包含服务器路径等敏感信息）
FIX_*.md
.pytest-tmp-*/
