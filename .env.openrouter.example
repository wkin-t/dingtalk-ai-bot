# OpenRouter 后端配置示例
# 复制为 .env.openrouter 并填入真实值

# ===== 必填 =====
DINGTALK_CLIENT_ID=your_dingtalk_client_id
DINGTALK_CLIENT_SECRET=your_dingtalk_client_secret
OPENROUTER_API_KEY=sk-or-v1-...

# ===== 模型选择 =====
# fast (日常对话) 主力模型，支持 openrouter.ai/models 里的任意模型
OPENROUTER_MODEL_FAST=openai/gpt-4.1-mini
# fast 回退模型列表（逗号分隔，按优先级排列）
OPENROUTER_FALLBACK_FAST=google/gemini-2.5-flash,anthropic/claude-haiku-4-5

# pro (复杂推理) 主力模型
OPENROUTER_MODEL_PRO=anthropic/claude-opus-4-5
# pro 回退模型列表
OPENROUTER_FALLBACK_PRO=openai/gpt-4.1,google/gemini-2.5-pro

# ===== 供应商路由（省钱关键）=====
# 留空 = OpenRouter 自动选最快；填 price = 自动选最便宜供应商
# 可选值: price, throughput, latency
OPENROUTER_PROVIDER_SORT=price

# ===== capability 覆盖（默认值已内置，按需修改）=====
# OPENROUTER_FAST_SUPPORTS_REASONING=false
# OPENROUTER_FAST_SUPPORTS_SEARCH=true
# OPENROUTER_FAST_SUPPORTS_VISION=true
# OPENROUTER_PRO_SUPPORTS_REASONING=true
# OPENROUTER_PRO_SUPPORTS_SEARCH=true
# OPENROUTER_PRO_SUPPORTS_VISION=true

# ===== 网络 =====
SOCKS_PROXY=socks5h://127.0.0.1:1080

# ===== 可选 =====
FLASK_PORT=35002
# REDIS_HOST=127.0.0.1
# MYSQL_HOST=127.0.0.1
