# ================= 原生 OpenRouter 后端配置示例 =================
# 适用于 AI_BACKEND=openrouter（app/openrouter_client.py，官方 openrouter SDK）
# 注意：该后端代码可用，但当前生产环境未部署。
# 生产上的 Claude 容器（docker-compose.anthropic.yml）走 AI_BACKEND=openai + 中转站，
# 与本模板无关，请使用 .env.anthropic.example。

# ===== 必填 =====
AI_BACKEND=openrouter
# 多容器共存时必须显式设置独立值，否则与其他容器撞键导致角色重塑失效
BOT_ID=openrouter
DINGTALK_CLIENT_ID=your_dingtalk_client_id
DINGTALK_CLIENT_SECRET=your_dingtalk_client_secret
OPENROUTER_API_KEY=sk-or-v1-...

# ===== 模型配置（三档统一变量）=====
MODEL_ROUTER=anthropic/claude-haiku-4-5    # 路由分析（不参与实际对话）
MODEL_LITE=anthropic/claude-haiku-4-5      # lite 档（简单问候）
MODEL_FAST=anthropic/claude-sonnet-4-5     # fast 档（普通工作）
MODEL_PRO=anthropic/claude-opus-4-5        # pro 档（高阶推理）

# ===== 模型 Fallback（OpenRouter 专属，fallback 路径不走 prompt cache）=====
OPENROUTER_FALLBACK_LITE=openai/gpt-4.1-nano
OPENROUTER_FALLBACK_FAST=openai/gpt-4.1
OPENROUTER_FALLBACK_PRO=anthropic/claude-sonnet-4-5

# ===== 供应商路由 =====
# 必须保持 Anthropic：否则请求可能被路由到 Bedrock，cache_control 被静默忽略
OPENROUTER_PROVIDER_ORDER=Anthropic
# 留空 = OpenRouter 自动选最快；可选值: price, throughput, latency
OPENROUTER_PROVIDER_SORT=price

# ===== capability 覆盖（默认值已内置，按需修改）=====
# OPENROUTER_LITE_SUPPORTS_VISION=true
# OPENROUTER_FAST_SUPPORTS_REASONING=true
# OPENROUTER_FAST_SUPPORTS_SEARCH=true
# OPENROUTER_FAST_SUPPORTS_VISION=true
# OPENROUTER_PRO_SUPPORTS_REASONING=true
# OPENROUTER_PRO_SUPPORTS_SEARCH=true
# OPENROUTER_PRO_SUPPORTS_VISION=true

# ===== 网络 =====
SOCKS_PROXY=socks5h://127.0.0.1:1080

# ===== 可选 =====
FLASK_PORT=35002
# REDIS_HOST=127.0.0.1
# MYSQL_HOST=127.0.0.1

# 全自主搜索：fast/pro 档始终挂原生搜索工具（模型自决是否搜索，不搜不计费），lite 档豁免
# false 回到路由 need_search 关键词门控
SEARCH_AUTONOMOUS=true

# /v1/chat/completions 鉴权 token（必配，fail-closed：未配置时该端点拒绝服务）
# 生成方式: openssl rand -hex 32；调用方以 OpenAI 客户端 api_key 形式携带
CHAT_COMPLETIONS_BEARER_TOKEN=
